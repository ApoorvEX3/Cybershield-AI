# ─────────────────────────────────────────────────────
#  CyberShield AI — Environment Variable Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# Flask settings
FLASK_DEBUG=false
PORT=5000
SECRET_KEY=replace-with-a-long-random-string

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# OpenAI API key — leave blank to use the rule-based fallback
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AI model to use (gpt-4o-mini is cheapest; gpt-4o is most capable)
AI_MODEL=gpt-4o-mini

# Optional: path to persist incidents as JSON
INCIDENT_STORE_FILE=incidents.json
